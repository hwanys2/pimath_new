{
  "name": "@hwanys2/pm-board",
  "version": "0.1.0",
  "description": "Shared interactive whiteboard for pimath and foreducator",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/hwanys2/pimath_new.git",
    "directory": "packages/pm-board"
  },
  "files": [
    "src",
    "dist",
    "styles"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./styles/pm-board.css": "./styles/pm-board.css"
  },
  "scripts": {
    "build": "npx tsup",
    "prepack": "npm run build"
  },
  "sideEffects": [
