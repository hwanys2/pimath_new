{
  "name": "@hwanys2/pm-board",
  "version": "0.1.31",
  "description": "Shared interactive whiteboard for pimath and foreducator",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/hwanys2/pimath_new.git",
    "directory": "packages/pm-board"
  },
  "files": [
    "src",
    "dist",
    "styles"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./styles/pm-board.css": "./styles/pm-board.css"
  },
  "scripts": {
    "build": "npx tsup",
    "prepack": "npm run build",
    "test:fold-net": "npx tsx --test src/lib/fold-net/solid-match.test.ts"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@react-three/drei": ">=10.0.0",
    "@react-three/fiber": ">=9.0.0",
    "katex": ">=0.16.0",
    "mafs": ">=0.21.0",
    "qrcode": ">=1.5.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "three": "^0.185.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
