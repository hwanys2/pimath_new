  ],
  "peerDependencies": {
    "katex": ">=0.16.0",
    "mafs": ">=0.21.0",
    "qrcode": ">=1.5.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
