# pimath independent — see docs/supabase-pm-conventions.md
# After cutover, point these at the new pimath project (not jmgoqpqyrnoamfjngcmy).
# Server-only vars (browser client is not used), matching Vercel's PM_ prefix.
# lib/supabase/env.ts also falls back to NEXT_PUBLIC_PM_* if set.
PM_SUPABASE_URL=https://YOUR_PIMATH_REF.supabase.co
PM_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key
# NEXT_PUBLIC_PM_SUPABASE_URL=
# NEXT_PUBLIC_PM_SUPABASE_ANON_KEY=

# Service role (server-only). Mailing campaigns / recipient snapshots. Never expose to the browser.
PM_SUPABASE_SERVICE_ROLE_KEY=

# 학생 로그인 세션 쿠키 서명용 (서버 전용, 긴 랜덤 문자열)
# Cutover 시에도 값을 바꾸지 마세요 (기존 학생 쿠키 호환).
PM_STUDENT_SESSION_SECRET=replace_with_long_random_string

# pimath 프로덕션 canonical origin (OAuth·이메일 인증 redirectTo용)
# 로컬에서는 비워 두고 request headers를 사용합니다.
PM_SITE_URL=https://pimath.kr

# Admin mailing — classic SES SMTP or Mail Manager SMTP
# From: "수학하는 즐거움" <noreply@pimath.kr>
AWS_SES_SMTP_USER=
AWS_SES_SMTP_PASS=
# Classic SES (AKIA… credentials):
# AWS_SES_SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
# Mail Manager (inp-… credentials) — must match the credential table endpoint:
# AWS_SES_SMTP_HOST=xxxx.jd2m.mail-manager-smtp.amazonaws.com

# Cron + mailing worker auth (Bearer). Also used to sign unsubscribe tokens if PM_MAIL_UNSUBSCRIBE_SECRET unset.
CRON_SECRET=
# PM_MAIL_UNSUBSCRIBE_SECRET=

# Google Analytics 4 (프로덕션에서만 로드)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-9122HY9024

# 전자칠판 필기 수식 인식 (Mathpix, 서버 전용 — 선생님 API)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# 전자칠판 방정식/부등식 풀이 (OpenAI, 서버 전용 — 없으면 기본 풀이만)
OPENAI_API_KEY=
